<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Chat App</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <h2>All Chats</h2>
    <% for(chat of chats){  %>

        <div class = "chat">
            <p>From : <i><%= chat.from %></i></p>
            <div class="msg">
                <p><%= chat.msg %></p>
            </div>
            <p>Received By: <i><%= chat.to %></i></p>
            <hr />
        </div>
        <br /><br>
    <% } %>
    
</body>
</html>