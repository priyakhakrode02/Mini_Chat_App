<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Chat App</title>
    <link rel="stylesheet" href="style.css" />
</head>
<body>
    <h2>All Chats</h2>
    <form method="get" action="/chats/new">
        <button class="btn1">New Chat</button>
    </form>
    <br /><br />
    
    <% for(chat of chats){  %>

        <div class = "chat">
            <p>From : <i><%= chat.from %></i></p>
            <div class="msg">
                <p><%= chat.msg %></p>
                <form method="get" action="/chats/<%= chat._id %>/edit">
                    <button class="edit_btn">Edit</button>
                </form>
                <form method="get" action="/chats/<%= chat._id %>/delete">
                    
                    <button name="delete">Delete</button>   
                </form>
            </div>
            <p>Received By: <i><%= chat.to %></i></p>
            <hr />
            <p><%= chat.created_at.toString().split(" ") [4]%></p>
            <p><%= chat.created_at.toString().split(" ").slice(0, 4). join(" ")%></p>
        </div>
        <br /><br>
    <% } %>
    
</body>
</html>