<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chat Edit Page</title>
</head>
<body>
    <h2>Edit Chats</h2>
    <p><b>Chat Id: <%= chat._id %></b></p>

    <form method="post" action="/chats/<%= chat._id %>?_method=PUT" >
        <textarea name="newMessage"><%= chat.msg %></textarea><br /><br />
        <button>Edit</button>
    </form>

    
    
</body>
</html>