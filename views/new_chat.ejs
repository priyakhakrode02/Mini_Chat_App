<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Chat Page</title>
</head>
<body>
    <h2>Write New Chat</h2>
    <form method="POST" action="/chats">

        <input type="text" name="from" placeholder="who are you ?"><br /><br />
        <textarea name="msg" placeholder="type new Message here..."></textarea><br><br>
        <input type="text" name="to" placeholder="Add Receiver"><br /><br />
        <button type="submit">Send</button>
    </form>
    
</body>
</html>